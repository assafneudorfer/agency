# Domain for the platform. Apps get <name>.<domain>, previews <name>-preview.<domain>.
AGENCY_BASE_DOMAIN=agency.example.com
# Email for Let's Encrypt
ACME_EMAIL=you@example.com
# Cloudflare API token with Zone:DNS:Edit on the zone, used for the wildcard certificate
CLOUDFLARE_DNS_API_TOKEN=

# Generate with: openssl rand -base64 32
AGENCY_SECRET_KEY=
POSTGRES_PASSWORD=

# First admin, created on first start when no users exist
AGENCY_ADMIN_EMAIL=
AGENCY_ADMIN_PASSWORD=

# LLM provider key(s) for the coding agent, and optionally a pi model pattern
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AGENCY_MODEL=
