#!/usr/bin/env bash
# Refreshes the short-lived AWS credentials of the all-AWS setup, Traefik (Route 53, for certificates) and
# the coding agent (Amazon Bedrock), and of the platform's ECS cluster (published apps and sandboxes on
# Fargate). Each comes from its own narrow IAM role, assumed with the server's
# instance role, so no keys are stored anywhere and neither can do the other's job.
# Runs at boot before Docker and every 15 minutes; the credentials last an hour.
set -euo pipefail
ENV=/opt/agency-src/.env
OUT=/var/lib/agency/aws
setting() { grep -E "^$1=" "$ENV" | cut -d= -f2- || true; }

[ -f "$ENV" ] || exit 0
REGION=$(setting AGENCY_AWS_REGION)
DNS_ROLE=$(setting AGENCY_DNS_ROLE_ARN)
BEDROCK_ROLE=$(setting AGENCY_BEDROCK_ROLE_ARN)
CLUSTER_ROLE=$(setting AGENCY_CLUSTER_ROLE_ARN)

# Writes credential_process JSON for one role to $OUT/<name>/credentials.json, atomically.
refresh() {
	local name=$1 role=$2
	[ -n "$role" ] || return 0
	umask 077
	mkdir -p "$OUT/$name"
	aws sts assume-role ${REGION:+--region "$REGION"} --role-arn "$role" --role-session-name "agency-$name" \
		--duration-seconds 3600 --output json \
		--query '{Version: `1`, AccessKeyId: Credentials.AccessKeyId, SecretAccessKey: Credentials.SecretAccessKey, SessionToken: Credentials.SessionToken, Expiration: Credentials.Expiration}' \
		>"$OUT/$name/credentials.json.partial"
	mv "$OUT/$name/credentials.json.partial" "$OUT/$name/credentials.json"
	# AWS profile for Traefik's SDK: it re-reads the file whenever the credentials expire.
	printf '[profile agency]\ncredential_process = cat /aws/credentials.json\n' >"$OUT/$name/config"
}

refresh dns "$DNS_ROLE"
refresh bedrock "$BEDROCK_ROLE"
refresh cluster "$CLUSTER_ROLE"
